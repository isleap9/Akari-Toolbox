<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AkariToolbox.App</RootNamespace>
    <AssemblyName>AkariToolbox.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;x86;arm64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Defender's cab+ps1 payload, embedded directly so the Defender workflow has no
         runtime dependency on PostInstallService / the downloaded C:\PostInstall mirror. -->
    <EmbeddedResource Include="Defender\NoDefender.cab" />
    <EmbeddedResource Include="Defender\DisableDefender.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-07/D-08: the PostInstall asset mirror's SHA256 pinning manifest — 147 relative-path
         to hex-digest entries, authored by downloading and hashing every file from the live
         isleap9/PostInstall repo this session. Consumed by PostInstallService's verify-or-reject
         download gate; never fabricated. -->
    <EmbeddedResource Include="Resources\PostInstallManifest.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-06 network-dependent one-shot scripts (02-CONTEXT.md), split one embedded resource
         per source menu branch and run via IScriptRunner.RunEmbeddedScriptAsync. Ported
         exactly as authored, with NO added SHA256/signature verification for v1 — explicit
         accepted user decision, not an oversight (see 02-06-PLAN.md, D-06). -->
    <EmbeddedResource Include="Resources\GamingScripts\driverclean-auto.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\driverclean-manual.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\directx.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\cpp.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\driverinstalllatest-nvidia.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\driverinstalllatest-amd.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\driverinstalllatest-intel.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\nvidiasettings-recommended.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\nvidiasettings-default.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\driverinstalldebloat-nvidia.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\driverinstalldebloat-amd.ps1" />
    <EmbeddedResource Include="Resources\GamingScripts\driverinstalldebloat-intel.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Debloat's embedded action scripts (DEBLOAT-01): 25 direct carries from the
         predecessor plus 3 branch-extracted replacements (D-03/D-06/D-08), split one file
         per script/branch matching Phase 2's proven convention. This plan (03-01) embeds
         only the tracer's one real action; later Wave 2-6 plans append more
         <EmbeddedResource> lines to this same ItemGroup. -->
    <EmbeddedResource Include="Resources\DebloatScripts\telemetry.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\telemetry-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\activityhistory.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\activityhistory-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\locationtracking.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\locationtracking-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\ps7telemetry.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\ps7telemetry-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\consumerfeatures.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\consumerfeatures-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\disablebgapps.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\disablebgapps-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\storesearch.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\storesearch-undo.ps1" />
    <!-- D-14: branch-extracted from the "Ultimate" collection's `6 Windows/9 Copilot.ps1`,
         not a direct predecessor carry (Copilot-only scope, narrower than the
         predecessor's WindowsAI.ps1/WindowsAI-Undo.ps1). -->
    <EmbeddedResource Include="Resources\DebloatScripts\windowsai.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\windowsai-undo.ps1" />
    <!-- 03-03: System & Performance category, 7 direct predecessor carries. -->
    <EmbeddedResource Include="Resources\DebloatScripts\visualeffects.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\visualeffects-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\services.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\services-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\deliveryoptimization.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\deliveryoptimization-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\hibernation.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\hibernation-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\storagesense.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\storagesense-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\wpbt.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\wpbt-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\utc.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\utc-undo.ps1" />
    <!-- 03-03 D-12/D-13: BitLocker — Disable, branch-extracted from the "Ultimate"
         collection's `3 Setup/1 BitLocker.ps1`, not a direct predecessor carry. Undo
         (branch 2, "BitLocker: On") only opens the BitLocker Control Panel for manual
         re-enable — it does not call Enable-BitLocker. -->
    <EmbeddedResource Include="Resources\DebloatScripts\disablebitlocker.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\disablebitlocker-undo.ps1" />
    <!-- 03-04: Explorer & UI category (5 direct predecessor carries) and the Tools
         category's single action (O&O ShutUp10++, run-only, no Undo counterpart). -->
    <EmbeddedResource Include="Resources\DebloatScripts\endtask.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\endtask-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\folderdiscovery.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\folderdiscovery-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\removehomeandgallery.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\removehomeandgallery-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\rightclickmenu.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\rightclickmenu-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\widgets.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\widgets-undo.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\oosu.ps1" />
    <!-- 03-05: Cleanup category's 3 direct-carry actions (Disk Cleanup, Temporary Files,
         OneDrive Remove). Disk Cleanup and Temporary Files are Run-only (no Undo, matching
         DebloatCatalog's UndoResourceSuffix: null); OneDrive Remove is a Run+Undo pair
         behind the D-11 confirmation gate. -->
    <EmbeddedResource Include="Resources\DebloatScripts\diskcleanup.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\tempfiles.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\removeonedrive.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\removeonedrive-undo.ps1" />
    <!-- 03-06 Task 1: D-03 branch-extracted Bloatware Run/Undo replacements (not direct
         predecessor carries), extracted from the "Ultimate" collection's
         `13 Bloatware.ps1` branches 2/4. -->
    <EmbeddedResource Include="Resources\DebloatScripts\bloatware-remove.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\bloatware-installall.ps1" />
    <!-- 03-06 Task 2: D-06/D-07/D-08 branch-extracted Edge & WebView / Edge Settings
         Run/Undo replacements (not direct predecessor carries), extracted from the
         "Ultimate" collection's `20 Edge & WebView.ps1` and `10 Edge Settings.ps1`.
         Both Undo branches (edgewebview-default, edgesettings-default) download
         unverified edge.exe/edgewebview.exe binaries (D-10, no SHA256/signature check,
         matching the existing D-06 accepted-risk precedent). -->
    <EmbeddedResource Include="Resources\DebloatScripts\edgewebview-uninstall.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\edgewebview-default.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\edgesettings-optimize.ps1" />
    <EmbeddedResource Include="Resources\DebloatScripts\edgesettings-default.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 04-03: D-04 per-app post-install hardening scripts for the 13 new Downloads-catalog
         apps — Start-Menu-shortcut-cleanup-only scripts (OS-standard ProgramData/AppData
         paths, never the app's own winget install path, per 04-RESEARCH.md Pitfall 1), plus
         one D-03 direct-CDN-install exception script (eft-install.ps1) for Escape From
         Tarkov, which has no winget package. Source: `4 Installers/1 Installers.ps1`. -->
    <EmbeddedResource Include="Resources\DownloadsScripts\frameview-harden.ps1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkariToolbox.Framework\AkariToolbox.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

</Project>
