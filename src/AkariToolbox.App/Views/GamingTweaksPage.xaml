<Page
    x:Class="AkariToolbox.App.Views.GamingTweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AkariToolbox.App.Models">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">

            <TextBlock
                Text="Gaming Tweaks"
                Style="{StaticResource TitleTextBlockStyle}" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tweaks}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:TweakItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16"
                            MaxWidth="640"
                            HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap"
                                        Opacity="0.8"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Display Settings" Command="{x:Bind ViewModel.OpenDisplaySettingsCommand}" />
                <Button Content="Advanced Graphics Settings (HAGS)" Command="{x:Bind ViewModel.OpenAdvancedGraphicsSettingsCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <ComboBox
                    Header="SvcHost Split Threshold"
                    ItemsSource="{x:Bind ViewModel.SvcHostPresetLabels}"
                    SelectedIndex="{x:Bind ViewModel.SelectedSvcHostIndex, Mode=TwoWay}"
                    MinWidth="220" />
                <ComboBox
                    Header="Win32 Priority Separation"
                    ItemsSource="{x:Bind ViewModel.Win32PriorityPresetLabels}"
                    SelectedIndex="{x:Bind ViewModel.SelectedWin32PriorityIndex, Mode=TwoWay}"
                    MinWidth="260" />
            </StackPanel>

            <TextBlock
                Text="Driver Tools (downloads third-party binaries — not integrity-verified)"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,16,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Driver Clean (DDU Auto)" Command="{x:Bind ViewModel.RunDriverCleanAutoCommand}" />
                <Button Content="Driver Clean (DDU Manual)" Command="{x:Bind ViewModel.RunDriverCleanManualCommand}" />
                <Button Content="DirectX" Command="{x:Bind ViewModel.RunDirectXCommand}" />
                <Button Content="C++ Redistributables" Command="{x:Bind ViewModel.RunCppCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
