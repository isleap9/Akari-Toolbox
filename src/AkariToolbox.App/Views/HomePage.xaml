<Page
    x:Class="AkariToolbox.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariToolbox.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="8">

            <TextBlock
                Text="Akari Toolbox"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Your control center for Akari OS — tuning, tweaks &amp; utilities"
                Opacity="0.8"
                Margin="0,0,0,16" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="280" MinItemHeight="120" MinColumnSpacing="16" MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeCard">
                        <Button
                            IsEnabled="{x:Bind IsEnabled}"
                            Tag="{x:Bind Target}"
                            Click="OnCardClick"
                            HorizontalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="White" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border
                                            Visibility="{x:Bind IsEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="4"
                                            Padding="6,1">
                                            <TextBlock Text="Coming soon" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap"
                                        Opacity="0.8"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
