<Page
    x:Class="AkariToolbox.App.Views.DownloadsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AkariToolbox.App.Models">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">

            <TextBlock
                Text="Downloads"
                Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox
                    Width="280"
                    PlaceholderText="Search apps..."
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Width="180"
                    ItemsSource="{x:Bind ViewModel.Categories}"
                    SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

                <Button
                    Content="Install Selected"
                    Command="{x:Bind ViewModel.InstallSelectedCommand}" />
            </StackPanel>

            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.8" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredApps}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:AppItem">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16"
                            MaxWidth="640"
                            HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    VerticalAlignment="Top" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap"
                                        Opacity="0.8"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Category}"
                                        Opacity="0.6"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>

                                <ProgressRing
                                    Grid.Column="2"
                                    IsActive="{x:Bind IsInstalling, Mode=OneWay}"
                                    Visibility="{x:Bind IsInstalling, Mode=OneWay}"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
