<Window
    x:Class="AkariToolbox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariToolbox.App">

    <Grid x:Name="RootElement" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Source="{x:Bind AppIconSource}"
                    Width="16"
                    Height="16"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="TitleText"
                    Text="{x:Bind AppTitle}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Shell content -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="232"
            SelectionChanged="OnNavSelectionChanged"
            MenuItemsSource="{x:Bind NavItems}"
            FooterMenuItemsSource="{x:Bind FooterNavItems}">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="local:NavigationItem">
                    <NavigationViewItem Content="{x:Bind Label}" Tag="{x:Bind PageType}" IsEnabled="{x:Bind IsEnabled}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" />

                <InfoBar
                    Grid.Row="1"
                    x:Name="ShellInfoBar"
                    Title="{x:Bind InfoBar.Title}"
                    Message="{x:Bind InfoBar.Message}"
                    Severity="{x:Bind InfoBar.Severity}"
                    IsClosable="{x:Bind InfoBar.IsClosable}"
                    IsOpen="{x:Bind InfoBar.IsOpen, Mode=TwoWay}" />

                <!-- Collapsible, in-memory-only log dock (D-05/D-06/D-07/D-08, APP-05).
                     Visible/expanded by default; user can collapse via the Expander's
                     own chevron toggle. No log file, no persistence across restarts. -->
                <Expander
                    Grid.Row="2"
                    x:Name="LogDockExpander"
                    Header="Log"
                    IsExpanded="True"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <ListView
                        x:Name="LogListView"
                        ItemsSource="{x:Bind LogConsole.Lines}"
                        Height="160"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Expander>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
