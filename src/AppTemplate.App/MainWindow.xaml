<Window
    x:Class="AkariToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariToolbox">

    <Grid x:Name="RootElement" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Source="{x:Bind AppIconSource}"
                    Width="16"
                    Height="16"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="TitleText"
                    Text="{x:Bind AppTitle}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Shell content -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="232"
            SelectionChanged="OnNavSelectionChanged"
            MenuItemsSource="{x:Bind NavItems}"
            FooterMenuItemsSource="{x:Bind FooterNavItems}">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="local:NavigationItem">
                    <NavigationViewItem Content="{x:Bind Label}" Tag="{x:Bind PageType}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" />

                <InfoBar
                    Grid.Row="1"
                    x:Name="ShellInfoBar"
                    Title="{x:Bind InfoBar.Title}"
                    Message="{x:Bind InfoBar.Message}"
                    Severity="{x:Bind InfoBar.Severity}"
                    IsClosable="{x:Bind InfoBar.IsClosable}"
                    IsOpen="{x:Bind InfoBar.IsOpen, Mode=TwoWay}" />
            </Grid>
        </NavigationView>

        <!-- Status footer: full-width strip pinned to the nav pane fill. -->
        <Border
            Grid.Row="2"
            Padding="16,8"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{x:Bind StatusText(Status.IsActive, Status.Message), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    Grid.Column="1"
                    Width="120"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind StatusFooterVisibility(Status.IsActive), Mode=OneWay}"
                    IsIndeterminate="{x:Bind Status.IsIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Value="{x:Bind Status.Value, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
