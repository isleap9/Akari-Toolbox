<Page
  x:Class="AkariToolbox.Views.GamingCatalogPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:AkariToolbox.ViewModels">

  <!--
  Gaming Catalog: the searchable four-group catalog (System / Network / GPU /
  Background). Every row carries its four inline explanation lines plus a
  Requires-restart badge when needed; the right column is a TwoWay tick plus a
  live state label. The top bar holds the AutoSuggestBox, the accent Apply
  selected (N) and the default-style Revert all changes (revert is the safe
  action, so it is never destructive-styled).

  Binding note: the page root uses classic {Binding} with DataContext; x:Bind
  appears only inside DataTemplates with x:DataType (page-level x:Bind dies
  with WMC9999). Item state lives on GamingCatalogRowItem because DataTemplates
  have no page-ancestor binding.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Padding="32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

  <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Gaming Catalog" />

  <StackPanel Orientation="Horizontal" Spacing="12">
  <AutoSuggestBox
  x:Name="SearchBox"
  Width="320"
  VerticalAlignment="Center"
  PlaceholderText="Search gaming tweaks"
  ItemsSource="{Binding Suggestions, Mode=OneWay}"
  TextChanged="OnSearchTextChanged"
  SuggestionChosen="OnSuggestionChosen"
  QuerySubmitted="OnQuerySubmitted" />
  <Button
  VerticalAlignment="Center"
  Style="{StaticResource AccentButtonStyle}"
  Content="{Binding ApplySelectedLabel, Mode=OneWay}"
  IsEnabled="{Binding CanApply, Mode=OneWay}"
  Command="{Binding ApplySelectedCommand, Mode=OneWay}" />
  <Button
  VerticalAlignment="Center"
  Content="Revert all changes"
  Command="{Binding RevertAllCommand, Mode=OneWay}"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </StackPanel>

  <ItemsControl ItemsSource="{Binding Groups, Mode=OneWay}">
  <ItemsControl.ItemsPanel>
  <ItemsPanelTemplate>
  <StackPanel Spacing="12" />
  </ItemsPanelTemplate>
  </ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate>
  <DataTemplate x:DataType="models:GamingCatalogGroup">
  <StackPanel Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
  <TextBlock Style="{StaticResource AkariSectionHeader}" Text="{x:Bind Title, Mode=OneWay}" />

  <Border Style="{StaticResource AkariCard}">
  <ItemsControl ItemsSource="{x:Bind Rows, Mode=OneWay}">
  <ItemsControl.ItemsPanel>
  <ItemsPanelTemplate>
  <StackPanel Spacing="12" />
  </ItemsPanelTemplate>
  </ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate>
  <DataTemplate x:DataType="models:GamingCatalogRowItem">
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>

  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="{x:Bind Entry.Title, Mode=OneWay}" />
  <TextBlock Style="{StaticResource AkariCardDescription}" Text="{x:Bind WhatLine, Mode=OneWay}" TextWrapping="Wrap" />
  <TextBlock Style="{StaticResource AkariCardDescription}" Text="{x:Bind WhyLine, Mode=OneWay}" TextWrapping="Wrap" />
  <TextBlock Style="{StaticResource AkariCardDescription}" Text="{x:Bind RiskLine, Mode=OneWay}" TextWrapping="Wrap" />
  <TextBlock Style="{StaticResource AkariCardDescription}" Text="{x:Bind RevertsLine, Mode=OneWay}" TextWrapping="Wrap" />
  <TextBlock
  Style="{StaticResource AkariCaption}"
  Text="Requires restart"
  Visibility="{x:Bind Entry.RequiresReboot, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
  </StackPanel>

  <CheckBox
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  Content="{x:Bind AppliedLabel, Mode=OneWay}"
  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
  IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" />
  </Grid>
  </DataTemplate>
  </ItemsControl.ItemTemplate>
  </ItemsControl>
  </Border>
  </StackPanel>
  </DataTemplate>
  </ItemsControl.ItemTemplate>
  </ItemsControl>

  <StackPanel
  Spacing="4"
  Visibility="{Binding HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
  <TextBlock Style="{StaticResource AkariSectionHeader}" Text="No matching tweaks" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="{Binding NoResultsDetail, Mode=OneWay}"
  TextWrapping="Wrap" />
  </StackPanel>

  </StackPanel>
  </ScrollViewer>
</Page>
