<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Native WinUI 3 styling. No custom theme dictionaries, no hardcoded colours:
        every brush comes from the system theme resources so light/dark/high-contrast
        all follow the OS. Mirrors the layout language of the WinUI-3-MVVM-Framework
        reference project (native text styles, CardBackgroundFillColorDefaultBrush
        surfaces, Spacing instead of per-element margins, default Buttons).
    -->

    <!-- Default card surface: native card fill + stroke, rounded corners. -->
    <Style x:Key="AkariCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Card heading: native body text, semibold. -->
    <Style x:Key="AkariCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Card body copy: native secondary fill, wrapped. -->
    <Style x:Key="AkariCardDescription" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Section label above a group of cards: native subtitle style. -->
    <Style x:Key="AkariSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Inline caption line (version strings, hints). -->
    <Style x:Key="AkariCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Standard page gutter. Pages use Padding + Spacing (native StackPanel layout). -->
    <Thickness x:Key="AkariPageMargin">32,32,32,32</Thickness>

</ResourceDictionary>
