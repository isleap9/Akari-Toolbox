<Page
  x:Class="AkariToolbox.Views.AkariTweaksPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:AkariToolbox.ViewModels">

  <!--
  32 live-state switches in a two-column card grid. Each card shows the tweak's
  title + description; flipping the switch applies it instantly off-thread and the
  shell's InfoBar reports the result.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Padding="32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
  <TextBlock Style="{StaticResource AkariSectionHeader}" Text="Tweaks" />
  <ItemsControl ItemsSource="{Binding Toggles, Mode=OneWay}">
  <ItemsControl.ItemsPanel>
  <ItemsPanelTemplate>
  <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
  </ItemsPanelTemplate>
  </ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate>
  <DataTemplate x:DataType="models:TweakToggleItem">
  <Border
  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
  CornerRadius="8"
  Padding="16"
  Margin="0,0,16,16">
  <Grid>
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel
  Grid.Column="0"
  VerticalAlignment="Center"
  Spacing="2">
  <TextBlock
  Style="{StaticResource AkariCardTitle}"
  Text="{x:Bind Title, Mode=OneWay}" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="{x:Bind Description, Mode=OneWay}" />
  </StackPanel>
  <ToggleSwitch
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
  IsOn="{x:Bind IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
  <ProgressRing
  Grid.Column="1"
  Width="24"
  Height="24"
  VerticalAlignment="Center"
  IsActive="{x:Bind IsBusy, Mode=OneWay}"
  Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
  </Border>
  </DataTemplate>
  </ItemsControl.ItemTemplate>
  </ItemsControl>
  </StackPanel>
  </ScrollViewer>
</Page>