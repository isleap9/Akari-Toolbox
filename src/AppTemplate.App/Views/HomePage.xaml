<Page
  x:Class="AkariToolbox.Views.HomePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:AkariToolbox.ViewModels">

  <!--
  Home: title, greeting, safety card, This PC spec card (facts + memory/drive bars)
  and the Tools jump grid. Same layout language as the WinUI-3-MVVM-Framework
  reference HomePage (native text styles, card fill, Spacing, default buttons,
  GridView tool tiles) with Akari Toolbox content. The reference's Open Settings /
  About / Refresh button row is intentionally omitted; the safety card keeps the
  restore-point and desktop-shortcut actions one tap away instead.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Padding="32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

  <TextBlock
  Text="{Binding ApplicationTitle, Mode=OneWay}"
  Style="{StaticResource TitleTextBlockStyle}" />

  <TextBlock
  TextWrapping="Wrap"
  Opacity="0.8"
  Text="Your control center for tuning, tweaks and utilities." />

  <TextBlock Text="Safety" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
  <Border
  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
  CornerRadius="8"
  Padding="16">
  <StackPanel Spacing="16">
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Create a Restore Point" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="These tweaks change the registry, services and drivers. Create a system restore point so you can roll back." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding CreateRestorePointAsyncCommand, Mode=OneWay}"
  Content="Create"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>

  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Akari Toolbox Shortcut" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Add an elevated Desktop shortcut so you can launch straight into UAC." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding CreateDesktopShortcutCommand, Mode=OneWay}"
  Content="Create"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>
  </StackPanel>
  </Border>

  <TextBlock Text="This PC" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
  <Border
  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
  CornerRadius="8"
  Padding="16">
  <StackPanel Spacing="14">
  <StackPanel Spacing="6">
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="120" />
  <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <TextBlock Text="Windows" Opacity="0.65" />
  <TextBlock Grid.Column="1" Text="{Binding OsInfo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="120" />
  <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <TextBlock Text="Processor" Opacity="0.65" />
  <TextBlock Grid.Column="1" Text="{Binding CpuInfo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="120" />
  <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <TextBlock Text="Graphics" Opacity="0.65" />
  <TextBlock Grid.Column="1" Text="{Binding GpuInfo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="120" />
  <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <TextBlock Text="Uptime" Opacity="0.65" />
  <TextBlock Grid.Column="1" Text="{Binding UptimeInfo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="120" />
  <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <TextBlock Text="Privileges" Opacity="0.65" />
  <TextBlock Grid.Column="1" Text="{Binding PrivilegesInfo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="120" />
  <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <TextBlock Text=".NET" Opacity="0.65" />
  <TextBlock Grid.Column="1" Text="{Binding DotNetInfo, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
  </StackPanel>

  <StackPanel Spacing="4">
  <TextBlock Text="Memory" Opacity="0.65" />
  <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryPercent, Mode=OneWay}" />
  <TextBlock Text="{Binding MemoryText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
  </StackPanel>

  <StackPanel Spacing="4">
  <TextBlock Text="System drive" Opacity="0.65" />
  <ProgressBar Minimum="0" Maximum="100" Value="{Binding DrivePercent, Mode=OneWay}" />
  <TextBlock Text="{Binding DriveText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
  </StackPanel>
  </StackPanel>
  </Border>

  <TextBlock Text="Tools" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
  <GridView ItemsSource="{Binding Tools, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False" Padding="0,0,0,24">
  <GridView.ItemTemplate>
  <DataTemplate x:DataType="models:HomeCard">
  <Button
  Command="{x:Bind OpenCardCommand, Mode=OneTime}"
  Width="230"
  Height="96"
  HorizontalContentAlignment="Left"
  VerticalContentAlignment="Top"
  Padding="14,12">
  <StackPanel Spacing="4">
  <TextBlock Text="{x:Bind Title, Mode=OneTime}" FontWeight="SemiBold" />
  <TextBlock
  Text="{x:Bind Description, Mode=OneTime}"
  TextWrapping="Wrap"
  Opacity="0.7"
  Style="{StaticResource CaptionTextBlockStyle}" />
  </StackPanel>
  </Button>
  </DataTemplate>
  </GridView.ItemTemplate>
  </GridView>

  </StackPanel>
  </ScrollViewer>
</Page>
