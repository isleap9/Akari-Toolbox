<Page
  x:Class="AkariToolbox.Views.GraphicsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:models="using:AkariToolbox.ViewModels">

  <!--
  5  Graphics: the Driver Management card (DDU + per-brand driver installs),
  the GPU Settings toggles and the Advanced GPU Tweaks card.

  WPF-UI substitutions: ui:Card  AkariCard Border, ui:Button  AkariTileButton,
  ui:ToggleSwitch  ToggleSwitch (IsChecked  IsOn), <Separator>  a 1px Rectangle
  filled with the card stroke brush. Labels and captions are verbatim from WPF.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Padding="32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

  <TextBlock Style="{StaticResource AkariSectionHeader}" Text="Driver Management" />

  <Border Style="{StaticResource AkariCard}">
  <StackPanel Spacing="16">
  <Grid>
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="8" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="DD Driver Clean" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Download DDU and wipe your GPU driver in safe mode. Auto cleans and reboots; Manual lets you drive." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding DduAutoCommand, Mode=OneWay}"
  Content="Auto"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  <Button
  Grid.Column="3"
  VerticalAlignment="Center"
  Command="{Binding DduManualCommand, Mode=OneWay}"
  Content="Manual"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>

  <Grid>
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="8" />
  <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="8" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Install Latest Driver" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Download and install the latest GPU driver for your brand." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding InstallNvidiaDriverCommand, Mode=OneWay}"
  Content="NVIDIA"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  <Button
  Grid.Column="3"
  VerticalAlignment="Center"
  Command="{Binding InstallAmdDriverCommand, Mode=OneWay}"
  Content="AMD"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  <Button
  Grid.Column="5"
  VerticalAlignment="Center"
  Command="{Binding InstallIntelDriverCommand, Mode=OneWay}"
  Content="Intel"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>

  <Grid>
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="8" />
  <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="8" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Driver + Apply Settings" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Install the latest driver and import the optimized GPU settings." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding InstallNvidiaDriverAndSettingsCommand, Mode=OneWay}"
  Content="NVIDIA"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  <Button
  Grid.Column="3"
  VerticalAlignment="Center"
  Command="{Binding InstallAmdDriverAndSettingsCommand, Mode=OneWay}"
  Content="AMD"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  <Button
  Grid.Column="5"
  VerticalAlignment="Center"
  Command="{Binding InstallIntelDriverAndSettingsCommand, Mode=OneWay}"
  Content="Intel"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>

  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Debloat Driver + Apply Settings" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Install the NVIDIA driver without bloat and apply optimized settings." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding InstallNvidiaDebloatAndSettingsCommand, Mode=OneWay}"
  Content="NVIDIA"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>
  </StackPanel>
  </Border>

  <TextBlock Style="{StaticResource AkariSectionHeader}" Text="GPU Settings" />

  <Border Style="{StaticResource AkariCard}">
  <StackPanel Spacing="16">
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="NVIDIA Settings" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Apply optimized NVIDIA control panel settings." />
  </StackPanel>
  <ToggleSwitch
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}"
  IsOn="{Binding NvidiaSettings, Mode=TwoWay}" />
  </Grid>

  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="AMD Settings" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Apply optimized AMD Radeon settings." />
  </StackPanel>
  <ToggleSwitch
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}"
  IsOn="{Binding AmdSettings, Mode=TwoWay}" />
  </Grid>

  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Intel Settings" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Apply optimized Intel Arc and iGPU settings." />
  </StackPanel>
  <ToggleSwitch
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}"
  IsOn="{Binding IntelSettings, Mode=TwoWay}" />
  </Grid>
  </StackPanel>
  </Border>

  <TextBlock Style="{StaticResource AkariSectionHeader}" Text="Advanced GPU Tweaks" />

  <Border Style="{StaticResource AkariCard}">
  <StackPanel Spacing="16">
  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Disable HDCP" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Turns off HDCP handshake on every display adapter." />
  </StackPanel>
  <ToggleSwitch
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}"
  IsOn="{Binding DisableHdcp, Mode=TwoWay}" />
  </Grid>

  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="P0 State" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Keeps the GPU in its highest performance power state." />
  </StackPanel>
  <ToggleSwitch
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}"
  IsOn="{Binding P0State, Mode=TwoWay}" />
  </Grid>

  <Grid ColumnSpacing="16">
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="MSI Mode" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Message Signaled Interrupts on every display adapter." />
  </StackPanel>
  <ToggleSwitch
  MinWidth="0"
  Grid.Column="1"
  VerticalAlignment="Center"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}"
  IsOn="{Binding MsiMode, Mode=TwoWay}" />
  </Grid>

  <Grid>
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="8" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="DirectX / C++ Runtimes" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Install or update DirectX and Visual C++ redistributables." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding InstallDirectXCommand, Mode=OneWay}"
  Content="DirectX"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  <Button
  Grid.Column="3"
  VerticalAlignment="Center"
  Command="{Binding InstallCppCommand, Mode=OneWay}"
  Content="C++"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>

  <Grid>
  <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*" />
  <ColumnDefinition Width="Auto" />
  <ColumnDefinition Width="8" />
  <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
  <TextBlock Style="{StaticResource AkariCardTitle}" Text="Resolution / Refresh Rate  HAGS" />
  <TextBlock
  Style="{StaticResource AkariCardDescription}"
  Text="Open display settings for resolution and HAGS controls." />
  </StackPanel>
  <Button
  Grid.Column="1"
  VerticalAlignment="Center"
  Command="{Binding OpenResolutionCommand, Mode=OneWay}"
  Content="Resolution"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  <Button
  Grid.Column="3"
  VerticalAlignment="Center"
  Command="{Binding OpenHagsCommand, Mode=OneWay}"
  Content="HAGS"
  IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource InvertedBool}}" />
  </Grid>
  </StackPanel>
  </Border>

  </StackPanel>
  </ScrollViewer>
</Page>
