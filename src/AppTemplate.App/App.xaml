<Application
    x:Class="AkariToolbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:AppTemplate.Framework.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Views/Shared/PageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumToStringConverter x:Key="EnumToStringConverter" />

            <!--
                Converters used by the page templates. x:Bind has no negation operator, so
                "disabled while busy" style bindings go through InvertedBool here  the same
                role WPF's InverseBool converter played in the original pages.
            -->
            <conv:InvertedBooleanConverter x:Key="InvertedBool" />
            <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:ObjectToVisibilityConverter x:Key="ObjectToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
